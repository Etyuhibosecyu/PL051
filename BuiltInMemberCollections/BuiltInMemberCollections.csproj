<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
		<PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.1" />
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.14" />
		<PackageReference Include="Nito.AsyncEx.Context" Version="5.1.2" />
		<PackageReference Include="NuGet.Protocol" Version="7.3.1" />
		<PackageReference Include="PanAndZoom" Version="12.0.0.1" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
		<ProjectReference Include="..\NStarType\NStarType.csproj" />
	  <Reference Include="RedStarMath">
	    <HintPath>packages\RedStarMath.dll</HintPath>
	  </Reference>
	  <Reference Include="RedStarMath.Complex">
	    <HintPath>packages\RedStarMath.Complex.dll</HintPath>
	  </Reference>
	  <None Update="packages\RedStarMath.Complex.dll">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="packages\RedStarMath.dll">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="packages\StringCache.programfile">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>
